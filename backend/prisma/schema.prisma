generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String      @id @default(cuid())
  name                  String      @default("NoName") // Sets 'name' to "NoName" if not provided
  email                 String      @unique
  password              String?

  googleId              String?     @unique

  isEmailVerified       Boolean     @default(false)

  isTwoFactorEnabled    Boolean     @default(false)
  twoFactorSecret       String?    
  twoFactorConfirmedAt  DateTime?  
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  recoveryCodes         String[]    @default([])
  sessions              Session[]
  userTokens            UserToken[]
}

model Session {
  id                    String      @id @default(uuid())
  userId                String
  revoked               Boolean     @default(false)
  createdAt             DateTime    @default(now())
  expiresAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserTokenType {
  EMAIL_VERIFICATION
  EMAIL_CHANGE
  PASSWORD_RESET
}

model UserToken {
  id                    String        @id @default(cuid())
  userId                String
  tokenHash             String        @unique
  expiresAt             DateTime
  createdAt             DateTime      @default(now())
  type                  UserTokenType
  pendingEmail          String?
  usedAt                DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

/**
 * In backend folder, run these when you update schemas
 * Migrate:
 * `pnpm prisma migrate dev --name add_favoriteColor_to_user`
 * To restore database tables based on existing migrations:
 * `pnpm prisma migrate dev`
 * Generate prisma client:
 * `pnpm prisma generate`
 * Run Studio:
 * `pnpm prisma studio`
 * Reset db, delete all data and re-apply migrations:
 * `pnpm prisma migrate reset`
 */
