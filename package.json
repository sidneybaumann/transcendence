{
  "name": "ft_transcendence",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "open": "^11.0.0",
    "prettier": "^3.8.1"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "concurrently \"pnpm -C backend dev\" \"pnpm -C frontend dev\"",
    "dev-all": "concurrently \"pnpm -C backend dev\" \"pnpm -C frontend dev\" \"pnpm run app\" \"pnpm run studio\" \"pnpm run mail\" \"pnpm run swagger\"",
    "studio": "pnpm --filter backend exec prisma studio",
    "mail": "node -e \"import('open').then(m => m.default('http://localhost:8025'))\"",
    "swagger": "node -e \"import('open').then(m => m.default('http://localhost:3000/documentation'))\"",
    "app": "node -e \"import('open').then(m => m.default('http://localhost:5173'))\"",
    "dev-elk": "./observability/scripts/dev-elk.sh",
    "db:studio": "pnpm -C backend prisma studio"
  }
}
